{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semclone.github.io/binarysniffer/schemas/family-2.0.json",
  "title": "binarysniffer family file, format 2.0",
  "description": "Groups components that share API surface (design 3.6). The compiler enforces two invariants over the member files: no member's anchor references a set intersecting `shared`, and every member gets an implicit exclude against each sibling's distinguishing sets unless it opts out. `default_member` is the one controlled exception to presence-only evidence and is only permitted when every other member has a distinguishing set with consumer_survival >= 0.9.",
  "type": "object",
  "properties": {
    "format": {
      "const": "binarysniffer-family/2.0"
    },
    "id": {
      "$ref": "#/$defs/familyId"
    },
    "members": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/componentId"
      }
    },
    "shared": {
      "type": "object",
      "properties": {
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kinds",
        "values"
      ],
      "additionalProperties": false
    },
    "exclusive": {
      "type": "boolean"
    },
    "default_member": {
      "oneOf": [
        {
          "$ref": "#/$defs/componentId"
        },
        {
          "type": "null"
        }
      ]
    },
    "unresolved": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "report": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "report"
      ],
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "properties": {
        "client": {
          "type": "string",
          "pattern": "^(>=|<=|>|<|=)?\\d+\\.\\d+$"
        }
      },
      "required": [
        "client"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "requires",
    "id",
    "members",
    "shared",
    "exclusive",
    "unresolved"
  ],
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "componentId": {
      "type": "string",
      "pattern": "^(?:[a-z0-9-]+/)?[a-z]+:[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
    },
    "familyId": {
      "type": "string",
      "pattern": "^(?:[a-z0-9-]+/)?[a-z0-9-]+(?:/[a-z0-9-]+)*$"
    }
  }
}
